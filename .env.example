# Copy to .env. Nothing is required for the default subscription backend.

# subscription (default): uses your Claude Pro/Max login through the Claude Code CLI.
#                         Needs `claude` installed and logged in once. No API key.
# api:                    uses the Anthropic API directly, billed per use. Needs ANTHROPIC_API_KEY.
BUDDY_BACKEND=subscription
ANTHROPIC_API_KEY=

# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5
BUDDY_MODEL=claude-opus-5-5

# Modifiers: ctrl, alt, shift, super. Last part is an X keysym name (space, b, F9, ...).
BUDDY_NOTCH_HOTKEY=ctrl+alt+space
# Stops the current answer from anywhere. (ctrl+alt+Escape is taken by GNOME.)
BUDDY_STOP_HOTKEY=ctrl+alt+BackSpace

# Hold Ctrl+Alt, point (or trace a circle) and release to have buddy explain it.
BUDDY_POINT_MODE=true

# Mouse/keyboard tasks: once = your request is the approval, steps run to the end
# (only a step that runs a command in a terminal asks first) | never = no approvals | each = approve every step
BUDDY_TASK_APPROVAL=once
# Language of point-mode answers: ko | en. Empty = same as your last typed question, then system locale.
BUDDY_LANGUAGE=

# Speak answers aloud with Microsoft Edge voices (free, needs internet).
BUDDY_SPEECH_ENABLED=true
BUDDY_VOICE_KO=ko-KR-SunHiNeural
BUDDY_VOICE_EN=en-US-AriaNeural

# Visual window GPU on NVIDIA PRIME laptops (only matters when __NV_PRIME_RENDER_OFFLOAD=1 is exported):
# auto = render on the integrated GPU (default), nvidia = keep the NVIDIA GPU (ANGLE over EGL)
BUDDY_VISUAL_GPU=auto
